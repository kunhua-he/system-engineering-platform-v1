{
  "包id": "样例.样本接入模块",
  "版本": "1.0.0",
  "说明": "判据 64 的老项目夹具：一个最小模块，专门带三类类型 —— 列表型参数、结果型结构、文本默认值。它不参与任何业务，只作翻译链的身份证。",
  "能力列表": [
    {
      "能力id": "样例.样本接入模块.取条目表",
      "版本": "1.0.0",
      "中文名称": "取条目表",
      "说明": "按范围取条目表；带文本型参数的显式空默认值，返回结果型结构，值结构里再嵌一个列表型字段。",
      "参数": [
        {
          "名称": "范围",
          "类型": "文本型",
          "必填": true,
          "默认值": null,
          "说明": "取条目的范围关键字（必填，非空文本）"
        },
        {
          "名称": "存储目录",
          "类型": "文本型",
          "必填": false,
          "默认值": "",
          "说明": "权威状态库所在目录；留空取实现层默认目录"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "条目表": "列表型，命中的条目顺序表",
          "数量": "整数型，命中条数"
        }
      },
      "错误码": ["范围不合法"]
    },
    {
      "能力id": "样例.样本接入模块.落条目",
      "版本": "1.0.0",
      "中文名称": "落条目",
      "说明": "把一张条目表落盘；带列表型参数与逻辑型显式默认值。",
      "参数": [
        {
          "名称": "条目表",
          "类型": "列表型",
          "必填": true,
          "默认值": null,
          "说明": "要落盘的条目表（必填）"
        },
        {
          "名称": "覆盖",
          "类型": "逻辑型",
          "必填": false,
          "默认值": false,
          "说明": "同名条目是否覆盖；不给即不覆盖"
        }
      ],
      "返回": {
        "类型": "结果型",
        "值结构": {
          "条目id": "文本型，落盘后生成的条目编号",
          "条目表": "列表型，落盘后的条目表"
        }
      },
      "错误码": ["条目表为空"]
    }
  ]
}
